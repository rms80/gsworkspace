# Backend
PORT=4000

# CORS - comma-separated list of allowed origins. localhost and same-origin
# requests are always allowed. Each entry is either a full origin matched
# exactly, or a leading-dot host suffix matching that domain and its subdomains
# (e.g. .example.com). Set this when reaching the backend through a reverse
# proxy that rewrites the Host header (e.g. a remote-access HTTPS proxy).
# ALLOWED_ORIGINS=https://app.example.com,.example.com

# Reverse proxy - set when running behind a proxy that adds X-Forwarded-For, so
# the rate limiter sees the real client IP. Value is a hop count, "true", or a
# CIDR/preset. Defaults to "loopback" (trusts only same-host proxies).
# TRUST_PROXY=loopback

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name

# Anthropic
GSWS_API_KEY_ANTHROPIC=your_anthropic_api_key

# Agent CLIs: if Claude Code and/or Codex are installed and logged in on this server, LLM requests
# use them (headless, single-shot, with the account they're logged in with) - no config needed.
# Claude models go to Claude Code (else the Anthropic API key above), GPT models and Codex image
# generation to Codex. An ANTHROPIC_API_KEY in the server's environment isn't passed to Claude Code.
# Set to true to stop using a CLI even when it's available:
# GSWS_DISABLE_CLAUDE_CODE=true
# GSWS_DISABLE_CODEX=true
# Which CLI's models are the defaults for new prompts and quick queries: claude-code or codex
# GSWS_PREFERRED_CLI=claude-code
# Paths to the CLIs, if they aren't on the PATH as "claude" and "codex"
# GSWS_CLAUDE_CODE_PATH=claude
# GSWS_CODEX_PATH=codex
# How long a CLI request may run before it's killed, in seconds (default 600)
# GSWS_CLI_TIMEOUT_SECONDS=600

# Agent sessions: persistent Claude Code / Codex conversations attached to scene objects, with full
# tool access (shell, file edits, MCP servers). Only served to requests from this machine unless:
# GSWS_AGENT_SESSIONS_ALLOW_REMOTE=true
# Where session records and the working folders of sessions not given a directory are kept
# (default: .gsworkspace-agents in the home folder)
# GSWS_AGENT_SESSIONS_DIR=/path/to/agent-sessions
# How long one turn of a session may run before it's killed, in seconds (default 3600)
# GSWS_AGENT_TURN_TIMEOUT_SECONDS=3600

# Google Gemini
GSWS_API_KEY_GEMINI=your_gemini_api_key

# Workspace folder name used as the S3 key prefix (or local disk subfolder)
# DEFAULT_WORKSPACE=default

# Server name (shown in login screen and status bar)
# SERVER_NAME=gsworkspace

# Authentication (leave AUTH_PASSWORD blank to disable auth)
# AUTH_PASSWORD=your_password_here
# SESSION_SECRET=random_secret_for_cookie_signing
# SESSION_MAX_AGE_DAYS=7

# Rate limits (max requests per 15 minutes)
RATE_LIMIT_GENERAL=1000
RATE_LIMIT_LLM=50
RATE_LIMIT_UPLOAD=60
